// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for identity management
model User {
  id          String   @id @default(uuid())
  uid         String   @unique
  publicKey   String   @unique
  fingerprint String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  ownedChannels   Channel[]      @relation("OwnerChannels")
  channelMembers  ChannelMember[]
  ownedGroups     Group[]        @relation("OwnerGroups")
  groupMembers    GroupMember[]
  sentMessages    Message[]      @relation("SentMessages")
  receivedMessages Message[]     @relation("ReceivedMessages")
  sessions        Session[]
  files           File[]

  @@map("users")
}

// Session management
model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])

  @@map("sessions")
}

// Channels for broadcasting
model Channel {
  id          String   @id @default(uuid())
  name        String
  description String?
  ownerId     String
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User           @relation("OwnerChannels", fields: [ownerId], references: [id])
  members     ChannelMember[]
  messages    Message[]

  @@map("channels")
}

// Channel membership
model ChannelMember {
  id        String   @id @default(uuid())
  channelId String
  userId    String
  role      String   @default("member") // member, admin, owner
  joinedAt  DateTime @default(now())

  channel   Channel  @relation(fields: [channelId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([channelId, userId])
  @@map("channel_members")
}

// Groups for private chats
model Group {
  id          String   @id @default(uuid())
  name        String
  description String?
  ownerId     String
  type        String   @default("private") // private, public
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User          @relation("OwnerGroups", fields: [ownerId], references: [id])
  members     GroupMember[]
  messages    Message[]

  @@map("groups")
}

// Group membership
model GroupMember {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  role      String   @default("member") // member, admin, owner
  joinedAt  DateTime @default(now())

  group     Group    @relation(fields: [groupId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@map("group_members")
}

// Messages model
model Message {
  id        String   @id @default(uuid())
  fromId    String
  toId      String?  // For direct messages
  channelId String?  // For channel messages
  groupId   String?  // For group messages
  content   String
  type      String   @default("text") // text, image, video, file, audio
  fileId    String?  // Reference to file if media
  timestamp DateTime @default(now())
  encrypted Boolean  @default(true)

  sender    User     @relation("SentMessages", fields: [fromId], references: [id])
  receiver  User?    @relation("ReceivedMessages", fields: [toId], references: [id])
  channel   Channel? @relation(fields: [channelId], references: [id])
  group     Group?   @relation(fields: [groupId], references: [id])
  file      File?

  @@map("messages")
}

// File storage
model File {
  id          String   @id @default(uuid())
  filename    String
  originalName String
  mimeType    String
  size        Int
  path        String
  thumbnail   String?
  uploadedById String
  createdAt   DateTime @default(now())

  uploadedBy  User     @relation(fields: [uploadedById], references: [id])
  messages    Message[]

  @@map("files")
}